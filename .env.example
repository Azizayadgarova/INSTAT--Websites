# API manzili. Prod uchun .env.production, lokal uchun .env.local yarating.
# Berilmasa src/config/api.js dagi standart qiymatlar (api1.instat.uz) ishlaydi.
VITE_API_URL=https://api1.instat.uz/api

VITE_API_STORAGE_URL=https://api1.instat.uz/media
VITE_API_CABINET_URL=https://my.instat.uz

# Faqat yangiliklar (site-posts) uchun manba — api1.instat.uz da bu jadval bo'sh.
# Yangiliklar asosiy backend'ga ko'chirilsa, buni VITE_API_URL bilan tenglashtiring.
VITE_API_NEWS_URL=https://test.avacoder.uz/api

# Faqat "Axborot resurslari" tashqi havolalari (site-data module="info_resource")
# uchun manba — api1.instat.uz da bu kalitlar bo'sh. Havolalar asosiy backend'ga
# ko'chirilsa, buni VITE_API_URL bilan tenglashtiring: teng bo'lganda qo'shimcha
# so'rov umuman yuborilmaydi.
VITE_API_INFO_RESOURCE_URL=https://test.avacoder.uz/api

# Sayt kanonik manzili (sitemap va SEO meta uchun)
VITE_SITE_URL=https://instat.uz
