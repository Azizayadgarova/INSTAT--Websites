# API manzili. Prod uchun .env.production, lokal uchun .env.local yarating.
# Berilmasa src/config/api.js dagi standart qiymatlar (api1.instat.uz) ishlaydi.
VITE_API_URL=https://api1.instat.uz/api

VITE_API_STORAGE_URL=https://api1.instat.uz/media
VITE_API_CABINET_URL=https://my.instat.uz

# Ixtiyoriy: yangiliklar (site-posts) va "Axborot resurslari" (site-data
# module="info_resource") uchun alohida manba. Berilmasa VITE_API_URL ishlatiladi.
# VITE_API_NEWS_URL=
# VITE_API_INFO_RESOURCE_URL=

# Sayt kanonik manzili (sitemap va SEO meta uchun)
VITE_SITE_URL=https://instat.uz
